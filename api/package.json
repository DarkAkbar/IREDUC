{
  "name": "ireduc-api",
  "version": "1.0.0",
  "private": true,
  "description": "API IREDUC — plateforme immobilière et services de l'habitat",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
