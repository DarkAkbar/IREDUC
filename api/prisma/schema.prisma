generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum SystemRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
}

enum ProviderType {
  INDIVIDUAL
  AGENCY
  SERVICE_PROVIDER
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ListingStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  ARCHIVED
}

enum OfferType {
  RENT
  SALE
}

enum PropertyKind {
  HOUSE
  APARTMENT
  VILLA
  LAND
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  COMPLETED
}

enum RequestTarget {
  PROPERTY
  SERVICE
}

enum ProjectType {
  RENT
  BUY
  OTHER
}

enum VisitMode {
  PHYSICAL
  VIRTUAL
}

enum MediaType {
  PHOTO
  VIDEO
}

enum PaymentStatus {
  UNPAID
  PAID
}

enum CategoryKind {
  REAL_ESTATE
  SERVICE
}

enum DocType {
  ID
  RCCM
  PATENTE
  PORTFOLIO
  REFERENCE
  AUTRE
}

enum TokenPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  id            String        @id @default(uuid()) @db.Uuid
  fullName      String
  email         String?       @unique
  passwordHash  String
  phone         String        @unique
  whatsapp      String?
  systemRole    SystemRole    @default(USER)
  accountStatus AccountStatus @default(ACTIVE)
  emailVerified Boolean       @default(false)
  phoneVerified Boolean       @default(false)
  avatarUrl     String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  providerProfile         ProviderProfile?
  ownedProperties         Property[]               @relation("PropertyOwner")
  requests                Request[]                @relation("RequestRequester")
  handledRequests         Request[]                @relation("RequestHandler")
  conversationParticipants ConversationParticipant[]
  messages                Message[]
  reviews                 Review[]
  favorites               Favorite[]
  alerts                  Alert[]
  notifications           Notification[]
  adminActions            AdminAction[]
  refreshTokens RefreshToken[]
  userTokens    UserToken[]

  @@index([email])
  @@index([phone])
  @@index([systemRole])
  @@index([accountStatus])
}

model ProviderProfile {
  id                String       @id @default(uuid()) @db.Uuid
  userId            String       @unique @db.Uuid
  type              ProviderType
  displayName       String
  logoUrl           String?
  description       String?
  contactEmail      String?
  phone             String?
  whatsapp          String?
  website           String?
  address           String?
  isRegistered      Boolean      @default(false)
  reviewStatus      ReviewStatus @default(PENDING)
  rejectionReason   String?
  yearsOfExperience Int?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents  ProviderDocument[]
  properties Property[]
  services   Service[]

  @@index([displayName])
  @@index([type])
  @@index([reviewStatus])
}

model ProviderDocument {
  id          String       @id @default(uuid()) @db.Uuid
  profileId   String       @db.Uuid
  docType     DocType
  fileUrl     String
  reviewStatus ReviewStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  profile ProviderProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([reviewStatus])
}

model Category {
  id        String       @id @default(uuid()) @db.Uuid
  name      String
  slug      String       @unique
  kind      CategoryKind
  icon      String?
  parentId  String?      @db.Uuid
  sortOrder Int          @default(0)
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  properties Property[]
  services   Service[]

  @@index([slug])
  @@index([kind])
  @@index([parentId])
  @@index([isActive])
}

model Commune {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  neighborhoods Neighborhood[]
  properties    Property[]
  services      Service[]      @relation("ServiceCoverage")

  @@index([name])
}

model Neighborhood {
  id        String   @id @default(uuid()) @db.Uuid
  communeId String   @db.Uuid
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  commune    Commune    @relation(fields: [communeId], references: [id], onDelete: Cascade)
  properties Property[]

  @@unique([communeId, name])
  @@index([communeId])
  @@index([name])
}

model Property {
  id                String        @id @default(uuid()) @db.Uuid
  ownerId           String        @db.Uuid
  providerProfileId String?       @db.Uuid
  categoryId        String        @db.Uuid
  offerType         OfferType
  kind              PropertyKind
  title             String
  description       String
  price             Decimal       @db.Decimal(14, 2)
  currency          String        @default("USD")
  communeId         String        @db.Uuid
  neighborhoodId    String?       @db.Uuid
  address           String?
  latitude          Float?
  longitude         Float?
  bedrooms          Int?
  bathrooms         Int?
  areaM2            Float?
  parking           Boolean?
  hasPool           Boolean?
  hasTitleDeed      Boolean?
  tags              String[]      @default([])
  status            ListingStatus @default(DRAFT)
  rejectionReason   String?
  viewsCount        Int           @default(0)
  isFeatured        Boolean       @default(false)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  owner           User             @relation("PropertyOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  providerProfile ProviderProfile? @relation(fields: [providerProfileId], references: [id], onDelete: SetNull)
  category        Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  commune         Commune          @relation(fields: [communeId], references: [id], onDelete: Restrict)
  neighborhood    Neighborhood?    @relation(fields: [neighborhoodId], references: [id], onDelete: SetNull)
  media           PropertyMedia[]
  requests        Request[]
  conversations   Conversation[]
  reviews         Review[]
  favorites       Favorite[]

  @@index([ownerId])
  @@index([providerProfileId])
  @@index([categoryId])
  @@index([offerType])
  @@index([kind])
  @@index([title])
  @@index([communeId])
  @@index([neighborhoodId])
  @@index([status])
  @@index([price])
  @@index([isFeatured])
  @@index([status, offerType, communeId])
  @@index([status, categoryId, price])
  @@index([status, kind, offerType])
}

model PropertyMedia {
  id         String    @id @default(uuid()) @db.Uuid
  propertyId String    @db.Uuid
  url        String
  type       MediaType @default(PHOTO)
  caption    String?
  sortOrder  Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([sortOrder])
}

model Service {
  id                String        @id @default(uuid()) @db.Uuid
  providerProfileId String        @db.Uuid
  categoryId        String        @db.Uuid
  title             String
  description       String
  subServices       String[]      @default([])
  status            ListingStatus @default(DRAFT)
  rejectionReason   String?
  isFeatured        Boolean       @default(false)
  viewsCount        Int           @default(0)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  providerProfile  ProviderProfile @relation(fields: [providerProfileId], references: [id], onDelete: Cascade)
  category         Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  coverageCommunes Commune[]       @relation("ServiceCoverage")
  media            ServiceMedia[]
  requests         Request[]
  conversations    Conversation[]
  reviews          Review[]
  favorites        Favorite[]

  @@index([providerProfileId])
  @@index([categoryId])
  @@index([title])
  @@index([status])
  @@index([isFeatured])
  @@index([status, categoryId])
  @@index([status, isFeatured])
}

model ServiceMedia {
  id        String    @id @default(uuid()) @db.Uuid
  serviceId String    @db.Uuid
  url       String
  type      MediaType @default(PHOTO)
  caption   String?
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
  @@index([sortOrder])
}

model Request {
  id             String        @id @default(uuid()) @db.Uuid
  number         String        @unique
  requesterId    String        @db.Uuid
  targetType     RequestTarget
  propertyId     String?       @db.Uuid
  serviceId      String?       @db.Uuid
  projectType    ProjectType
  desiredDate    DateTime?
  durationMonths Int?
  occupants      Int?
  visitMode      VisitMode?
  visitDate      DateTime?
  visitSlot      String?
  fullName       String
  phone          String
  email          String?
  whatsapp       String?
  message        String?       @db.VarChar(500)
  status         RequestStatus @default(PENDING)
  rejectionReason String?
  paymentStatus  PaymentStatus @default(UNPAID)
  handledById    String?       @db.Uuid
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  requester   User          @relation("RequestRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  property    Property?     @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  service     Service?      @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  handledBy   User?         @relation("RequestHandler", fields: [handledById], references: [id], onDelete: SetNull)
  conversation Conversation?
  review       Review?

  @@index([number])
  @@index([requesterId])
  @@index([targetType])
  @@index([propertyId])
  @@index([serviceId])
  @@index([status])
  @@index([paymentStatus])
  @@index([handledById])
}

model Conversation {
  id         String   @id @default(uuid()) @db.Uuid
  requestId  String?  @unique @db.Uuid
  propertyId String?  @db.Uuid
  serviceId  String?  @db.Uuid
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  request      Request?                  @relation(fields: [requestId], references: [id], onDelete: SetNull)
  property     Property?                 @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  service      Service?                  @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  participants ConversationParticipant[]
  messages     Message[]

  @@index([propertyId])
  @@index([serviceId])
}

model ConversationParticipant {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @db.Uuid
  userId         String   @db.Uuid
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String    @id @default(uuid()) @db.Uuid
  conversationId String    @db.Uuid
  senderId       String    @db.Uuid
  content        String
  readAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
}

model Review {
  id         String   @id @default(uuid()) @db.Uuid
  requestId  String   @unique @db.Uuid
  authorId   String   @db.Uuid
  serviceId  String?  @db.Uuid
  propertyId String?  @db.Uuid
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  request  Request   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  author   User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  service  Service?  @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  property Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  @@index([authorId])
  @@index([serviceId])
  @@index([propertyId])
  @@index([rating])
}

model Favorite {
  id         String        @id @default(uuid()) @db.Uuid
  userId     String        @db.Uuid
  targetType RequestTarget
  propertyId String?       @db.Uuid
  serviceId  String?       @db.Uuid
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  service  Service?  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([propertyId])
  @@index([serviceId])
  @@index([targetType])
}

model Alert {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  criteria  Json
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isActive])
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  type      String
  title     String
  body      String
  data      Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([readAt])
}

model AdminAction {
  id         String   @id @default(uuid()) @db.Uuid
  adminId    String   @db.Uuid
  targetType String
  targetId   String
  action     String
  reason     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  admin User @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([targetType, targetId])
  @@index([createdAt])
}

/// Paramètres plateforme (clé → JSON). Alimente aussi GET /config.
model Setting {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
}

model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String
  expiresAt  DateTime
  revokedAt  DateTime?
  deviceName String?
  userAgent  String?
  ipAddress  String?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
}

model UserToken {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @db.Uuid
  purpose   TokenPurpose
  tokenHash String
  codeHash  String?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([purpose])
  @@index([tokenHash])
  @@index([codeHash])
  @@index([expiresAt])
}
