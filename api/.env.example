# Base de données PostgreSQL — UNE SEULE base de travail : ireduc
# (les tests Vitest utilisent api/.env.test → ireduc_test, jamais ireduc)
DATABASE_URL="postgresql://ireduc:ireduc_dev@localhost:5432/ireduc?schema=public"

# Secrets JWT (obligatoires — ne jamais committer les vraies valeurs)
JWT_SECRET="changez-moi-par-un-secret-fort"
JWT_REFRESH_SECRET="changez-moi-par-un-autre-secret-fort"

# Serveur
PORT=3000
APP_URL="http://localhost:3000"
# development | test | production
NODE_ENV="development"

# Si true : les actions sensibles exigent phoneVerified (vérification numéro).
# false (défaut) : aucun blocage ; le code de vérification reste disponible.
REQUIRE_ACCOUNT_VERIFICATION="false"

# E-mail : console | resend | smtp
MAIL_DRIVER="console"
MAIL_FROM="IREDUC <noreply@ireduc.cd>"

# Requis si MAIL_DRIVER=resend
RESEND_API_KEY=""

# Requis si MAIL_DRIVER=smtp
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
